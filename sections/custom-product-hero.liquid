    gap: 10px;

    margin-top: 12px;

    overflow-x: auto;

  }


  #custom-product-hero-{{ section.id }} .coffee-thumb {

    width: 70px;

    min-width: 70px;

    height: 70px;

    padding: 0;

    border: 2px solid transparent;

    background: white;

    cursor: pointer;

    border-radius: 6px;

    overflow: hidden;

  }


  #custom-product-hero-{{ section.id }} .coffee-thumb.active {

    border-color: #6b3f20;

  }


  #custom-product-hero-{{ section.id }} .coffee-thumb img {

    width: 100%;

    height: 100%;

    object-fit: cover;

  }


  /* Gallery arrows */

  #custom-product-hero-{{ section.id }} .gallery-prev,
  #custom-product-hero-{{ section.id }} .gallery-next {

    position: absolute;

    top: 50%;

    transform: translateY(-50%);

    border: 0;

