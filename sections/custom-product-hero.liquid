    padding: 60px 20px;

    background: #faf8f3;

    color: #241b16;

  }


  #custom-product-hero-{{ section.id }} .coffee-hero__inner {

    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 60px;

  }


  #custom-product-hero-{{ section.id }} img {

    max-width: 100%;

    display: block;

  }


  /* Gallery */

