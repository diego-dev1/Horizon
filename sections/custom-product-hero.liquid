    z-index: 2;

  }


  #custom-product-hero-{{ section.id }} .gallery-prev {

    left: 12px;

  }


  #custom-product-hero-{{ section.id }} .gallery-next {

    right: 12px;

  }


  /* Product info */

  #custom-product-hero-{{ section.id }} h1 {

    font-size: 42px;

    line-height: 1.1;

    margin: 0 0 15px;

  }


  #custom-product-hero-{{ section.id }} .coffee-rating {

    color: #c47a20;

    margin-bottom: 10px;

  }


  #custom-product-hero-{{ section.id }} .coffee-rating span {

    color: #625a55;

  }


  #custom-product-hero-{{ section.id }} .coffee-description {

    line-height: 1.6;

    color: #625a55;

  }


  /* Benefits */

  #custom-product-hero-{{ section.id }} .coffee-benefits {

    padding: 0;

    list-style: none;

    margin: 20px 0;

  }


  #custom-product-hero-{{ section.id }} .coffee-benefits li {

    margin: 7px 0;

  }


  /* Selectors */

  #custom-product-hero-{{ section.id }} .selector {

    margin-top: 28px;

  }


  #custom-product-hero-{{ section.id }} h2 {

    font-size: 18px;

    margin-bottom: 12px;

  }


  #custom-product-hero-{{ section.id }} .flavor-options,
  #custom-product-hero-{{ section.id }} .purchase-options {

    display: grid;

    gap: 10px;

  }


  #custom-product-hero-{{ section.id }} .flavor-option,
  #custom-product-hero-{{ section.id }} .purchase-option,
  #custom-product-hero-{{ section.id }} .pack-option {

    border: 1px solid #d8d0ca;

    background: white;

    border-radius: 10px;

    padding: 14px;

    text-align: left;

    cursor: pointer;

    transition: .2s ease;

  }


  #custom-product-hero-{{ section.id }} .flavor-option:hover,
  #custom-product-hero-{{ section.id }} .purchase-option:hover,
  #custom-product-hero-{{ section.id }} .pack-option:hover {

    border-color: #6b3f20;

  }


  #custom-product-hero-{{ section.id }} .flavor-option.active,
  #custom-product-hero-{{ section.id }} .purchase-option.active,
  #custom-product-hero-{{ section.id }} .pack-option.active {

    border-color: #6b3f20;

    box-shadow: 0 0 0 2px rgba(107,63,32,.12);

  }


  #custom-product-hero-{{ section.id }} .flavor-option span,
  #custom-product-hero-{{ section.id }} .purchase-option span {

    display: block;

    margin-top: 5px;

    color: #746c66;

    font-size: 14px;

  }


  /* Packs */

  #custom-product-hero-{{ section.id }} .pack-options {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 10px;

  }


  #custom-product-hero-{{ section.id }} .pack-option {

    display: flex;

    flex-direction: column;

    gap: 6px;

  }


  #custom-product-hero-{{ section.id }} .pack-price {

    font-size: 20px;

    font-weight: 700;

  }


  #custom-product-hero-{{ section.id }} .pack-option small {

    color: #746c66;

  }


  #custom-product-hero-{{ section.id }} .pack-badge {

    background: #6b3f20;

    color: white;

    font-size: 10px;

    padding: 4px 6px;

    align-self: flex-start;

    border-radius: 4px;

  }


  /* Price */

  #custom-product-hero-{{ section.id }} .coffee-price {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-top: 30px;

    padding-top: 20px;

    border-top: 1px solid #ddd;

  }


  #custom-product-hero-{{ section.id }} .coffee-price strong {

    font-size: 32px;

  }


  /* CTA */

  #custom-product-hero-{{ section.id }} .coffee-cta {

    width: 100%;

    margin-top: 18px;

    padding: 17px;

    border: 0;

    border-radius: 8px;

    background: #6b3f20;

    color: white;

    font-weight: 700;

    font-size: 17px;

    cursor: pointer;

    transition: .2s ease;

  }


  #custom-product-hero-{{ section.id }} .coffee-cta:hover {

    background: #4f2d17;

  }


  #custom-product-hero-{{ section.id }} .coffee-cta:disabled {

    opacity: .6;

    cursor: wait;

  }


  /* Mobile */

  @media (max-width: 749px) {

    #custom-product-hero-{{ section.id }} {

      padding: 30px 15px;

    }


    #custom-product-hero-{{ section.id }} .coffee-hero__inner {

      grid-template-columns: 1fr;

      gap: 30px;

    }


    #custom-product-hero-{{ section.id }} h1 {

      font-size: 32px;

    }


    #custom-product-hero-{{ section.id }} .pack-options {

      grid-template-columns: 1fr;

    }

  }

</style>


<script>

(() => {

  const root = document.getElementById(
    'custom-product-hero-{{ section.id }}'
  );

  if (!root) return;


  /* --------------------------------
     Shopify Variants
  -------------------------------- */

  const variantsElement =
    document.getElementById(
      'coffee-variants-{{ section.id }}'
    );


  if (!variantsElement) return;


  const variants =
    JSON.parse(
      variantsElement.textContent
    );


  /* --------------------------------
     Elements
  -------------------------------- */

  const price =
    root.querySelector(
      '#coffee-price-{{ section.id }}'
    );


  const cta =
    root.querySelector(
      '#coffee-cta-{{ section.id }}'
    );


  /* --------------------------------
     Discount Code
     
     IMPORTANT:
     Create this exact discount code
     in Shopify Admin:
     
     SUBSCRIBE10
  -------------------------------- */

  const SUBSCRIBE_DISCOUNT =
    'SUBSCRIBE10';


  /* --------------------------------
     Current selections
  -------------------------------- */

  let flavor = '';

  let pack = '';

  let purchaseType = 'one_time';


  /* --------------------------------
     Initial selections
  -------------------------------- */

  const activeFlavorButton =
    root.querySelector(
      '.flavor-option.active'
    );


  const activePackButton =
    root.querySelector(
      '.pack-option.active'
    );


  if (activeFlavorButton) {

    flavor =
      activeFlavorButton.dataset.flavor;

  }


  if (activePackButton) {

    pack =
      activePackButton.dataset.pack;

  }


  /*
   * Fallback
   */
  if (!flavor || !pack) {

    const firstVariant =
      variants.find(
        variant => variant.available
      ) || variants[0];


    if (firstVariant) {

      flavor =
        firstVariant.options[0];

      pack =
        firstVariant.options[1];

    }

  }


  /* --------------------------------
     Select helper
  -------------------------------- */

  function select(
    selector,
    element
  ) {

    root
      .querySelectorAll(selector)
      .forEach(item => {

        item.classList.remove(
          'active'
        );

      });


    element.classList.add(
      'active'
    );

  }


  /* --------------------------------
     Get Shopify Variant
  -------------------------------- */

  function getVariant() {

    return variants.find(
      variant => {

        return (

          variant.options[0] === flavor &&

          variant.options[1] === pack

        );

      }
    );

  }


  /* --------------------------------
     Money
  -------------------------------- */

  function formatMoney(
    cents
  ) {

    return (
      '$' +
      (
        Number(cents) / 100
      ).toFixed(2)
    );

  }


  /* --------------------------------
     Update Price
  -------------------------------- */

  function updatePrice() {

    const variant =
      getVariant();


    if (!variant) {

      price.textContent =
        'Unavailable';

      cta.disabled = true;

      return;

    }


    let amount =
      Number(variant.price);


    /*
     * Display 10% discount
     * when Subscribe is selected.
     */
    if (
      purchaseType ===
      'subscribe'
    ) {

      amount =
        amount * 0.90;

    }


    price.textContent =
      formatMoney(amount);


    if (!variant.available) {

      cta.disabled = true;

      cta.textContent =
        'SOLD OUT';

    } else {

      cta.disabled = false;

      cta.textContent =
        'GET MY COFFEE →';

    }

  }


  /* --------------------------------
     Flavor
  -------------------------------- */

  root
    .querySelectorAll(
      '.flavor-option'
    )
    .forEach(button => {

      button.addEventListener(
        'click',
        () => {

          flavor =
            button.dataset.flavor;


          select(
            '.flavor-option',
            button
          );


          updatePrice();

        }
      );

    });


  /* --------------------------------
     Purchase Type
  -------------------------------- */

  root
    .querySelectorAll(
      '.purchase-option'
    )
    .forEach(button => {

      button.addEventListener(
        'click',
        () => {

          purchaseType =
            button.dataset.purchase;


          select(
            '.purchase-option',
            button
          );


          updatePrice();

        }
      );

    });


  /* --------------------------------
     Pack
  -------------------------------- */

  root
    .querySelectorAll(
      '.pack-option'
    )
    .forEach(button => {

      button.addEventListener(
        'click',
        () => {

          pack =
            button.dataset.pack;


          select(
            '.pack-option',
            button
          );


          updatePrice();

        }
      );

    });


  /* --------------------------------
     ADD TO CART
  -------------------------------- */

  cta.addEventListener(
    'click',
    async () => {

      if (cta.disabled) return;


      const variant =
        getVariant();


      if (!variant) {

        console.error(
          'Shopify variant not found.',
          {
            flavor,
            pack,
            variants
          }
        );


        alert(
          'Please select a valid flavor and pack.'
        );


        return;

      }


      if (!variant.available) {

        alert(
          'This variant is currently sold out.'
        );


        return;

      }


      /*
       * Disable CTA
       */

      cta.disabled = true;

      cta.textContent =
        'ADDING…';


      try {

        /*
         * Add product to Shopify cart
         */

        const response =
          await fetch(
            window.Shopify.routes.root +
            'cart/add.js',
            {

              method: 'POST',

              headers: {

                'Content-Type':
                  'application/json',

                'Accept':
                  'application/json'

              },

              body: JSON.stringify({

                items: [

                  {

                    id:
                      Number(
                        variant.id
                      ),

                    quantity: 1

                  }

                ]

              })

            }
          );


        const data =
          await response.json();


        /*
         * Shopify error
         */

        if (!response.ok) {

          throw new Error(
            data.description ||
            data.message ||
            'Unable to add product to cart.'
          );

        }


        console.log(
          'Added to cart:',
          data
        );


        /*
         * Subscribe:
         * Apply actual Shopify discount
         *
         * One-Time:
         * Normal cart
         */

        if (
          purchaseType ===
          'subscribe'
        ) {

          cta.textContent =
            'APPLYING DISCOUNT…';


          /*
           * Redirect using discount URL.
           *
           * Shopify applies the discount
           * code to the cart.
           */

          const discountUrl =
            window.Shopify.routes.root +
            'discount/' +
            encodeURIComponent(
              SUBSCRIBE_DISCOUNT
            ) +
            '?redirect=/cart';


          window.location.href =
            discountUrl;


        } else {

          /*
           * Normal one-time purchase
           */

          cta.textContent =
            'ADDED ✓';


          setTimeout(
            () => {

              window.location.href =
                window.Shopify.routes.root +
                'cart';

            },
            300
          );

        }


      } catch (error) {

        console.error(
          'Add to cart error:',
          error
        );


        cta.disabled = false;

        cta.textContent =
          'GET MY COFFEE →';


        alert(
          error.message ||
          'Something went wrong. Please try again.'
        );

      }

    }
  );


  /* --------------------------------
     Gallery
  -------------------------------- */

  const thumbs = [

    ...root.querySelectorAll(
      '.coffee-thumb'
    )

  ];


  const mainImage =
    root.querySelector(
      '#coffee-main-image-{{ section.id }}'
    );


  let currentImage = 0;


  function showImage(index) {

    if (
      !thumbs.length ||
      !mainImage
    ) {

      return;

    }


    currentImage =
      (
        index +
        thumbs.length
      ) %
      thumbs.length;


    mainImage.src =
      thumbs[
        currentImage
      ].dataset.image;


    thumbs.forEach(
      (thumb, i) => {

        thumb.classList.toggle(
          'active',
          i === currentImage
        );

      }
    );

  }


  /* Thumbnail */

  thumbs.forEach(
    (thumb, index) => {

      thumb.addEventListener(
        'click',
        () => {

          showImage(index);

        }
      );

    }
  );


  /* Previous */

  const previous =
    root.querySelector(
      '.gallery-prev'
    );


  if (previous) {

    previous.addEventListener(
      'click',
      () => {

        showImage(
          currentImage - 1
        );

      }
    );

  }


  /* Next */

  const next =
    root.querySelector(
      '.gallery-next'
    );


  if (next) {

    next.addEventListener(
      'click',
      () => {

        showImage(
          currentImage + 1
        );

      }
    );

  }


  /* --------------------------------
     Initial Price
  -------------------------------- */

  updatePrice();


})();
</script>


{% schema %}

{
  "name": "Custom Product Hero",

  "settings": [],

  "presets": [
    {
      "name": "Custom Product Hero"
    }
  ]

}

{% endschema %}
