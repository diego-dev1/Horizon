<section
  id="custom-product-hero-{{ section.id }}"
  class="coffee-hero"
>
  <div class="coffee-hero__inner">

    <!-- Gallery -->
    <div class="coffee-gallery">

      <div class="coffee-gallery__main">

        {% if product.featured_image %}
          <img
            id="coffee-main-image-{{ section.id }}"
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
          >
        {% endif %}

        {% if product.images.size > 1 %}

          <button
            type="button"
            class="gallery-prev"
            aria-label="Previous image"
          >
            ‹
          </button>

          <button
            type="button"
            class="gallery-next"
            aria-label="Next image"
          >
            ›
          </button>

        {% endif %}

      </div>


      <div class="coffee-gallery__thumbs">

        {% for image in product.images %}

          <button
            type="button"
            class="coffee-thumb{% if forloop.first %} active{% endif %}"
            data-image="{{ image | image_url: width: 900 }}"
          >

            <img
              src="{{ image | image_url: width: 150 }}"
              alt="{{ image.alt | default: product.title | escape }}"
            >

          </button>

        {% endfor %}

      </div>

    </div>


    <!-- Product Information -->
    <div class="coffee-info">

      <!-- Rating -->
      <div class="coffee-rating">
        ★★★★★ <span>4.8/5</span>
      </div>


      <!-- Title -->
      <h1>{{ product.title }}</h1>


      <!-- Description -->
      <div class="coffee-description">
        {{ product.description }}
      </div>


      <!-- Benefits -->
      <ul class="coffee-benefits">

        <li>✓ Convenient individual sachets</li>
        <li>✓ Rich coffee flavor</li>
        <li>✓ Perfect for home or travel</li>

      </ul>


      <!-- FLAVOR -->
      <div class="selector">

        <h2>1. Choose Your Flavor</h2>

        <div class="flavor-options">

          {% assign flavors = product.options_with_values | where: "name", "Flavor" %}

          {% if flavors.size > 0 %}

            {% for value in flavors.first.values %}

              <button
                type="button"
                class="flavor-option{% if forloop.first %} active{% endif %}"
                data-flavor="{{ value | escape }}"
              >

                <strong>{{ value }}</strong>

                {% case value %}

                  {% when 'Classic Roast' %}
                    <span>Rich and balanced</span>

                  {% when 'Vanilla Latte' %}
                    <span>Smooth and lightly sweet</span>

                  {% when 'Mocha' %}
                    <span>Coffee with chocolate notes</span>

                  {% else %}
                    <span>Choose this flavor</span>

                {% endcase %}

              </button>

            {% endfor %}

          {% endif %}

        </div>

      </div>


      <!-- PURCHASE TYPE -->
      <div class="selector">

        <h2>2. Choose Purchase Type</h2>

        <div class="purchase-options">

          <button
            type="button"
            class="purchase-option active"
            data-purchase="one_time"
          >

            <strong>One-Time Purchase</strong>

            <span>Regular price</span>

          </button>


          <button
            type="button"
            class="purchase-option"
            data-purchase="subscribe"
          >

            <strong>Subscribe &amp; Save</strong>

            <span>Additional 10% Off</span>

          </button>

        </div>

      </div>


      <!-- PACK -->
      <div class="selector">

        <h2>3. Choose Your Pack</h2>

        <div class="pack-options">

          {% assign pack_option = product.options_with_values | where: "name", "Pack" %}

          {% if pack_option.size > 0 %}

            {% for pack in pack_option.first.values %}

              {% assign pack_number = pack
                | remove: ' Sachets'
                | strip
                | plus: 0
              %}


              {% case pack_number %}

                {% when 12 %}

                  {% assign base_price = 19.99 %}
                  {% assign serving_price = 1.67 %}

                {% when 24 %}

                  {% assign base_price = 31.99 %}
                  {% assign serving_price = 1.33 %}

                {% when 48 %}

                  {% assign base_price = 51.99 %}
                  {% assign serving_price = 1.08 %}

                {% else %}

                  {% assign base_price = 0 %}
                  {% assign serving_price = 0 %}

              {% endcase %}


              <button
                type="button"
                class="pack-option{% if forloop.index == 2 %} active{% endif %}"
                data-pack="{{ pack | escape }}"
                data-price="{{ base_price }}"
              >

                {% if pack_number == 24 %}

                  <span class="pack-badge">
                    MOST POPULAR
                  </span>

                {% elsif pack_number == 48 %}

                  <span class="pack-badge">
                    BEST VALUE
                  </span>

                {% endif %}


                <strong>{{ pack }}</strong>


                <span class="pack-price">

                  {{ base_price | times: 100 | money }}

                </span>


                <small>

                  {{ serving_price | times: 100 | money }}
                  per serving

                </small>


                {% if pack_number == 24 %}

                  <small>Save 20%</small>

                {% elsif pack_number == 48 %}

                  <small>Save 35%</small>

                {% endif %}

              </button>

            {% endfor %}

          {% endif %}

        </div>

      </div>


      <!-- PRICE -->
      <div class="coffee-price">

        <span>Your price</span>

        <strong id="coffee-price-{{ section.id }}">
          $31.99
        </strong>

      </div>


      <!-- CTA -->
      <button
        type="button"
        id="coffee-cta-{{ section.id }}"
        class="coffee-cta"
      >
        GET MY COFFEE →
      </button>

      <button
  type="button"
  id="coffee-buy-button-{{ section.id }}"
  class="coffee-buy-button"
>
  BUY NOW →
</button>


    </div>

  </div>


  <!-- Shopify Variant Data -->
  <script
    type="application/json"
    id="coffee-variants-{{ section.id }}"
  >
    [
      {% for variant in product.variants %}

        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price | json }},
          "available": {{ variant.available | json }}
        }

        {% unless forloop.last %},{% endunless %}

      {% endfor %}
    ]
  </script>

</section>


<style>

